{
  "trailingSlash": true,
  "redirects": [
    { "source": "/terms", "destination": "/algemene-voorwaarden/", "type": 301 },
    { "source": "/en", "destination": "/", "type": 301 },
    { "source": "/privacy-verklaring", "destination": "/", "type": 301 },
    { "source": "/disclaimer", "destination": "/", "type": 301 }
  ],
  "headers": [
    {
      "source": "assets/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "img/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
